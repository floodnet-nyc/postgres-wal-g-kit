# Pick one of the storage backends below and fill in the relevant details.

# ------ Using Different Locations for Fetch and Push --------------------------

# YOU MOST LIKELY WANT THIS OPTION. I assume you have functional backups already writing to a remote location and do not want to clobber anything.

# By default, WAL-G uses a single storage backend, which you configure by setting one of:
#   WALG_AZ_PREFIX, WALG_S3_PREFIX, WALG_GS_PREFIX, or WALG_FILE_PREFIX.
#
# If you want to fetch backups from one location (for example, Azure) and push them to another (for example, the local filesystem), 
# you can use the following variables instead:

WALG_FETCH_PREFIX=azure://<YOUR-CONTAINER>/<PATH-IN-CONTAINER>   # Location to fetch backups from (e.g. azure://..., ./... (local path), s3://..., gs://...)
WALG_PUSH_PREFIX=<PATH-IN-CONTAINER>                             # Location to push backups to   (e.g. azure://..., ./... (local path), s3://..., gs://...)

# wal-g-env will automatically detect the correct backend based on the URL scheme (azure://, ./ for local, s3://, gs://).
# To use this feature, run the `wal-g-env` script instead of calling `wal-g` directly.

# When using WALG_FETCH_PREFIX and WALG_PUSH_PREFIX, you do not need to set WALG_AZ_PREFIX, WALG_S3_PREFIX, WALG_GS_PREFIX, or WALG_FILE_PREFIX.
# However, you still need to provide the appropriate credentials for each backend (for example, AZURE_STORAGE_ACCOUNT and AZURE_STORAGE_ACCESS_KEY for Azure).





# ------------------------------------------------
# These other options are the traditional way of configuring WAL-G with a single storage backend.

# ------ Azure -----------------------------------

# WALG_AZ_PREFIX=azure://<YOUR-CONTAINER>/<PATH-IN-CONTAINER>  # e.g. azure://timescalebackup/sgbackups.stackgres.io/cluster-config/timescale/16
AZURE_STORAGE_ACCOUNT=<YOUR-STORAGE-ACCOUNT-NAME>
AZURE_STORAGE_ACCESS_KEY=<YOUR-ACCOUNT-ACCESS-KEY>
# If using a SAS token instead of access key:
# AZURE_STORAGE_SAS_TOKEN=<YOUR-SAS-TOKEN>



# ------ S3 -----------------------------------

# WALG_S3_PREFIX=s3://<YOUR-BUCKET>/<PATH-IN-BUCKET>  # e.g. s3://mybucket/pgbackups
AWS_ACCESS_KEY_ID=<YOUR-ACCESS-KEY-ID>
AWS_SECRET_ACCESS_KEY=<YOUR-SECRET-ACCESS-KEY>
AWS_REGION=<YOUR-REGION>  # e.g. us-east-1
# If using a custom S3 endpoint (e.g. MinIO), also set:
AWS_ENDPOINT_URL=<YOUR-ENDPOINT-URL>



# ------ GCS -----------------------------------

# WALG_GS_PREFIX=gs://<YOUR-BUCKET>/<PATH-IN-BUCKET>  # e.g. gs://mybucket/pgbackups
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-credentials.json  # inside container path to GCP credentials file



# ------ Local filesystem --------------------------

# WALG_FILE_PREFIX=<PATH-IN-CONTAINER>  # e.g. /backups
